# RAG 服务配置样例。复制为 .env 后按本机情况修改（.env 不入库）。
#
# 厂商与模型均可配置，不绑定 Ollama。换 embedding 模型是一个显式动作：
# collection 以模型名和维度命名，换模型即换 collection，须由 Java 触发全量重建。

# ---- embedding：provider / model / dim 三元组 ----
# provider 可选 ollama | openai | deepseek
# openai/deepseek 使用兼容协议；所填端点必须实际提供 embedding API。
EMBEDDING_PROVIDER=ollama
# 默认 bge-m3（中文强、1024 维）。对照组：nomic-embed-text（英文模型，768 维），
# 跑同一份黄金问答集出对比数字。
EMBEDDING_MODEL=bge-m3
# 必须与模型实际输出维度一致：不一致时 embed 立即报错拒绝写入，
# 否则错配会推迟到检索时才暴露，且表现为距离计算异常，极难定位。
EMBEDDING_DIM=1024
# Ollama 填根地址；OpenAI 兼容端点可填根地址或以 /v1 结尾的地址。
EMBEDDING_BASE_URL=http://localhost:11434
# 本地 Ollama 留空；需要鉴权的端点填写其密钥，同时用于模型列表探测和 embedding。
EMBEDDING_API_KEY=
# 单次模型 HTTP 请求的超时（秒），不是整篇文档的总截止时间；不自动重试。
EMBEDDING_TIMEOUT_SECONDS=60

# ---- 切片参数 ----
# 本地 Hugging Face tokenizer JSON；切换 embedding 模型时须同时提供匹配的 tokenizer。
# 相对路径以 rag-service 为基准；不自动下载，不回退为字符计数。替换文件后重启服务。
# 文件缺失、损坏或不能编码输入时 /chunk 返回 503，不阻止进程启动。
CHUNK_TOKENIZER_PATH=data/tokenizers/bge-m3-5617a9f61b028005a4858fdac845db406aefb181.json
# 首版是经验值，M2 基线跑完后按黄金集调优——每次调整都是一条带数字的 PR
# 预算包含非空标题路径和模型特殊 token；max > 0，0 <= min <= max。
CHUNK_MAX_TOKENS=512
CHUNK_MIN_TOKENS=64

# ---- 批量 ----
# Python 内部批量大小，不是 HTTP 请求上限；Java 每次发送一篇文档的完整 chunks。
EMBED_BATCH_SIZE=64

# 注意：这里没有 JAVA_BASE_URL。推模式下 Python 不知道 Java 在哪，
# 也不需要知道——全量重建由 Java 编排，Python 从不反向调用（B-6）。

# ---- LLM：模块 C，创建模型时才读取，不影响 /health 启动 ----
# 以 API 为主、本地可切（C-5）：provider / model / base_url 三元组一改即切，
# 代码零改动。实测 API 不只是快（直答 24s vs 本地 7b 83s、拒答 2s vs 55s），
# 引用标记与三态判定的稳定性也明显更好，而这两项直接影响溯源质量。
#
# LLM_PROVIDER 选择 LangChain 适配器：openai（含一切 OpenAI 兼容端点）或 deepseek。
LLM_PROVIDER=openai
LLM_MODEL=<你的模型名>
LLM_BASE_URL=<你的 API 端点，如 https://api.deepseek.com/v1>
LLM_API_KEY=<你的密钥>
# 超时按最慢的部署形态定：本地 7b 单问实测 72-83 秒，云端 API 通常 5-25 秒。
LLM_TIMEOUT_SECONDS=180

# 常见配置示例：
# DeepSeek：LLM_PROVIDER=deepseek，LLM_MODEL=deepseek-chat，LLM_BASE_URL=https://api.deepseek.com
# OpenAI：  LLM_PROVIDER=openai，LLM_BASE_URL=https://api.openai.com/v1
# 本地 Ollama（离线备选，走 OpenAI 兼容端点；ollama 是占位 key 不是真实密钥）：
#   LLM_PROVIDER=openai，LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
#   LLM_BASE_URL=http://localhost:11434/v1，LLM_API_KEY=ollama
#
# LLM_BASE_URL 可省略以使用适配器默认地址；LLM_MODEL、LLM_API_KEY 必填——
# 缺失时 /query 返回 503 LLM_NOT_CONFIGURED（"没配"与"挂了"必须可区分）。
# 工厂关闭 SDK 自动重试，超时和上游错误由调用方处理，不隐式追加模型请求。
